# Pathwise Configuration
# Copy to .env and adjust values

# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Application
PATHWISE_HOST=0.0.0.0
PATHWISE_PORT=8000
PATHWISE_DEBUG=false

# Repository indexing
ALLOWED_ROOT=.
MAX_FILE_SIZE_KB=500
MAX_FILE_COUNT=1000
MAX_REPO_SIZE_MB=50

# Optional LLM (not required for core functionality)
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
